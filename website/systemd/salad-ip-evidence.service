[Unit]
Description=Read-only IP evidence evaluator and saved ranking index
After=local-fs.target
StartLimitIntervalSec=0

[Service]
User=salad
Group=salad-ui
WorkingDirectory=/run/salad-ip-code
Environment=HOME=/home/salad
Environment=PYTHONPATH=/run/salad-ip-code
ExecStart=/usr/bin/python3 -B -m dashboard.ip_evaluator --data-dir /home/salad/.hg1 --index /var/lib/salad-ip-evidence/evidence.sqlite3
Restart=always
RestartSec=10
RuntimeDirectory=salad-ip-code
RuntimeDirectoryMode=0750
StateDirectory=salad-ip-evidence
StateDirectoryMode=0750
UMask=0027
Nice=5
CPUWeight=20
MemoryMax=768M
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadOnlyPaths=/run/salad-ip-code /home/salad/.hg1
InaccessiblePaths=/opt/wdi -/opt/salad -/etc/cloudflared-salad -/run/salad-credentials
BindReadOnlyPaths=/opt/wdi/website/dashboard:/run/salad-ip-code/dashboard

[Install]
WantedBy=multi-user.target
