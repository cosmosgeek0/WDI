# /etc/systemd/system/cloudflared-salad.service
[Unit]
Description=Salad Cloudflare tunnel
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=cloudflared-salad
Group=cloudflared-salad
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared-salad/tunnel.token
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
IPAddressDeny=169.254.169.254/32
UMask=0027
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
