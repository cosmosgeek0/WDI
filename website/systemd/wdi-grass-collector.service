[Unit]
Description=WDI Grass read-only traffic and status collector
After=network-online.target
Wants=network-online.target
[Service]
User=salad
Group=salad
WorkingDirectory=/opt/wdi/website
Environment=HOME=/home/salad
Environment=PYTHONPATH=/opt/wdi/website
EnvironmentFile=/etc/wdi/grass.env
ExecStart=/usr/bin/python3 -B collectors/grass.py
Restart=on-failure
RestartSec=30
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/salad/.hg1/grass
InaccessiblePaths=-/etc/cloudflared-salad -/var/lib/wdi
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
