# /etc/systemd/system/salad-public-flow.service
[Unit]
Description=Anonymous retained network flow export
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=salad-flow
Group=salad-flow
Environment=PYTHONPATH=/opt/wdi/website
ExecStart=/usr/bin/python3 -B /opt/wdi/website/public-flow/export_flow.py --state /var/lib/cosmosgeek-public-flow --inventory-source grass
Restart=on-failure
RestartSec=5
StateDirectory=cosmosgeek-public-flow
StateDirectoryMode=0755
UMask=0077
Nice=15
CPUQuota=25%
MemoryMax=256M
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=tmpfs
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/wdi/website
BindReadOnlyPaths=/home/salad/.hg1/hg-fleet /home/salad/.hg1/packetstream /home/salad/.hg1/proxyrack /home/salad/.hg1/repocket /home/salad/.hg1/earnfm /home/salad/.hg1/traffmonetizer /home/salad/.hg1/pawns /home/salad/.hg1/grass
InaccessiblePaths=-/run/salad-credentials -/etc/cloudflared-salad -/etc/cosmosgeek-public-metrics -/run/salad-ui
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
